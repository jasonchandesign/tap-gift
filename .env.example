# Copy to .env for local work. Real keys live only in .env and Render environment variables.

# PayPal sandbox app (Accept payments turned on)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Claude API
ANTHROPIC_API_KEY=

# Channel3 product search
CHANNEL3_API_KEY=

# Render Postgres
DATABASE_URL=

# Public URL of the app, used for card and gift links
APP_URL=http://localhost:3000
